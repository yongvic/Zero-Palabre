# Neon — pooler (runtime Next.js). Copier depuis le dashboard Neon « Pooled connection »
# IMPORTANT : ne pas utiliser channel_binding=require (échec sous Node.js / Windows)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon — connexion directe (prisma migrate / db push). « Direct connection »
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# true = magic link affiché dans le terminal (recommandé en local)
AUTH_EMAIL_DEV=true

# Resend — https://resend.com/api-keys (utiliser onboarding@resend.dev tant que le domaine n'est pas vérifié)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="Zéro-Palabre <onboarding@resend.dev>"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Vercel — marquer les accords en retard (Authorization: Bearer <secret>)
CRON_SECRET="generate-a-long-random-string"

# Fonctionnalités vocales (UI masquée par défaut — code conservé)
# VOICE_FEATURES_ENABLED=true
# IA vocale — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# Alias accepté : GOOGLE_GENERATIVE_AI_API_KEY=""

# PWA Phase 2 — notifications push (optionnel)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"
# Paiements simulés MVP (Tmoney-Moov mode test)
PAYMENT_MODE="simulation"
PAYMENT_WEBHOOK_SECRET="whsec_dev_secret"
