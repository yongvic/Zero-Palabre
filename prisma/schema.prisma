generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String?
  phone                String?
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  kycStatus            KycStatus            @default(NONE)
  subscriptionStatus   SubscriptionStatus   @default(FREE)
  paymentCustomerId    String?              @unique
  freeAccordsUsed      Int                  @default(0)
  cguAcceptedAt        DateTime?

  accounts             Account[]
  sessions             Session[]
  accordsInitiated     Accord[]             @relation("Initiateur")
  accordsReceived      Accord[]             @relation("Destinataire")
  subscription         Subscription?
  reliabilityScore     ReliabilityScore?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Accord {
  id              String       @id @default(cuid())
  reference       String       @unique
  publicToken     String       @unique @default(cuid())
  titre           String
  description     String       @db.Text
  montant         Decimal?     @db.Decimal(12, 2)
  devise          String       @default("FCFA")
  dateEcheance    DateTime?
  type            AccordType
  statut          AccordStatut @default(PENDING)
  destinataireNom String
  destinataireEmail String
  commentaireRefus String?     @db.Text
  contentHash     String?
  pdfUrl          String?
  inviteExpiresAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  validatedAt     DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?

  initiateurId    String
  destinataireId  String?

  initiateur      User         @relation("Initiateur", fields: [initiateurId], references: [id])
  destinataire    User?        @relation("Destinataire", fields: [destinataireId], references: [id])
  historique      AccordEvent[]
}

model AccordEvent {
  id        String   @id @default(cuid())
  accordId  String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  plan             Plan     @default(FREE)
  status           String   @default("active")
  paymentSubId     String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReliabilityScore {
  id           String   @id @default(cuid())
  userId       String   @unique
  score        Int      @default(50)
  totalAccords Int      @default(0)
  honored      Int      @default(0)
  disputed     Int      @default(0)
  lastUpdated  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccordType {
  PRET
  PRESTATION
  LOCATION
  COMMANDE
  AUTRE
}

enum AccordStatut {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  HONORED
  DISPUTED
}

enum KycStatus {
  NONE
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}
