generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String?
  familyName           String?
  username             String?              @unique
  phone                String?
  dateOfBirth          DateTime?
  address              String?              @db.Text
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  password             String?              @db.Text
  kycStatus            KycStatus            @default(NONE)
  subscriptionStatus   SubscriptionStatus   @default(FREE)
  paymentCustomerId    String?              @unique
  freeAccordsUsed      Int                  @default(0)
  cguAcceptedAt        DateTime?

  accounts             Account[]
  sessions             Session[]
  accordsInitiated     Accord[]             @relation("Initiateur")
  accordsReceived      Accord[]             @relation("Destinataire")
  subscription         Subscription?
  reliabilityScore     ReliabilityScore?
  voiceAccordDrafts    VoiceAccordDraft[]
  fulfillmentsConfirmed AccordFulfillment[] @relation("FulfillmentConfirmedBy")
  wallet               Wallet?
  paymentIntents       PaymentIntent[]
  accordSignatures     AccordSignature[]
  notifications        UserNotification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Accord {
  id              String       @id @default(cuid())
  reference       String       @unique
  publicToken     String       @unique @default(cuid())
  titre           String
  description     String       @db.Text
  montant         Decimal?     @db.Decimal(12, 2)
  devise          String       @default("FCFA")
  dateEcheance    DateTime?
  type            AccordType
  statut          AccordStatut @default(PENDING)
  destinataireNom String
  destinataireEmail String
  commentaireRefus String?     @db.Text
  contentHash     String?
  pdfUrl          String?
  inviteExpiresAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  validatedAt     DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?

  counterpartyUsername String?
  repaymentMode        RepaymentMode?
  signatureExpiresAt   DateTime?

  initiateurId    String
  destinataireId  String?

  initiateur      User         @relation("Initiateur", fields: [initiateurId], references: [id])
  destinataire    User?        @relation("Destinataire", fields: [destinataireId], references: [id])
  historique      AccordEvent[]
  voiceSessions   VoiceSignatureSession[]
  partySessions   AccordPartySession[]
  fulfillment     AccordFulfillment?
  signatures      AccordSignature[]
  notarialAct     AccordNotarialAct?
  notifications   UserNotification[]
}

model AccordPartySession {
  id              String              @id @default(cuid())
  sessionId       String              @unique @default(cuid())
  accordId        String
  role            String              @default("DESTINATAIRE")
  status          PartySessionStatus  @default(IN_PROGRESS)
  currentStep     Int                 @default(1)
  confirmedName   String?
  confirmedEmail  String?
  fieldResponses  Json                @default("{}")
  signatureName   String?
  cguAcceptedAt   DateTime?
  consentAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@index([accordId])
  @@index([expiresAt])
}

enum PartySessionStatus {
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

model VoiceSignatureSession {
  id            String               @id @default(cuid())
  sessionId     String               @unique @default(cuid())
  accordId      String
  intent        String?
  transcripts   Json                 @default("[]")
  extracted     Json?
  missingFields Json                 @default("[]")
  audioUrls     Json                 @default("[]")
  status        VoiceSessionStatus   @default(IN_PROGRESS)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@index([accordId])
  @@index([expiresAt])
}

enum VoiceSessionStatus {
  IN_PROGRESS
  READY
  APPLIED
  EXPIRED
}

model VoiceAccordDraft {
  id            String   @id @default(cuid())
  sessionId     String   @unique @default(cuid())
  userId        String
  transcripts   Json     @default("[]")
  extracted     Json?
  missingFields Json     @default("[]")
  audioUrls     Json     @default("[]")
  status        VoiceDraftStatus @default(IN_PROGRESS)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum VoiceDraftStatus {
  IN_PROGRESS
  READY
  APPLIED
  EXPIRED
}

model AccordFulfillment {
  id              String            @id @default(cuid())
  accordId        String            @unique
  fulfillToken    String            @unique @default(cuid())
  status          FulfillmentStatus @default(PENDING)

  amountDeclared  Decimal?          @db.Decimal(12, 2)
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  reference       String?
  proofData       String?           @db.Text

  declaredName    String?
  declaredEmail   String?
  declaredAt      DateTime?

  confirmedAt     DateTime?
  confirmedById   String?
  rejectedAt      DateTime?
  rejectReason    String?           @db.Text

  fulfillmentHash String?
  trustLevel      Int               @default(2)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  accord          Accord            @relation(fields: [accordId], references: [id], onDelete: Cascade)
  confirmedBy     User?             @relation("FulfillmentConfirmedBy", fields: [confirmedById], references: [id])

  @@index([fulfillToken])
  @@index([status])
}

enum FulfillmentStatus {
  PENDING
  DECLARED
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  TMONEY
  FLOOZ
  CASH
  BANK_TRANSFER
  OTHER
}

model AccordEvent {
  id        String   @id @default(cuid())
  accordId  String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  plan             Plan     @default(FREE)
  status           String   @default("active")
  paymentSubId     String?
  currentPeriodEnd DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReliabilityScore {
  id           String   @id @default(cuid())
  userId       String   @unique
  score        Int      @default(50)
  totalAccords Int      @default(0)
  honored      Int      @default(0)
  disputed     Int      @default(0)
  lastUpdated  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccordType {
  PRET
  PRESTATION
  LOCATION
  COMMANDE
  AUTRE
}

enum AccordStatut {
  PENDING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  OVERDUE
  HONORED
  DISPUTED
  AWAITING_INITIATOR_SIGN
  AWAITING_COUNTERPARTY_SIGN
  DUAL_SIGNED
  CANCELLED_TIMEOUT
  ESCROW_FUNDED
  ACTIVE
  REPAYING
  CLOSED
}

enum RepaymentMode {
  MUTUAL_CONFIRM
  SCHEDULED_DEBIT
}

enum SignatureRole {
  INITIATOR
  COUNTERPARTY
}

model NotarialTemplate {
  id           String     @id @default(cuid())
  version      String
  accordType   AccordType
  stampUrl     String
  fieldsSchema Json       @default("{}")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  acts AccordNotarialAct[]
}

model AccordNotarialAct {
  id           String   @id @default(cuid())
  accordId     String   @unique
  templateId   String
  filledFields Json
  contentHash  String?
  generatedAt  DateTime @default(now())

  accord   Accord           @relation(fields: [accordId], references: [id], onDelete: Cascade)
  template NotarialTemplate @relation(fields: [templateId], references: [id])
}

model AccordSignature {
  id         String         @id @default(cuid())
  accordId   String
  userId     String
  role       SignatureRole
  signedName String
  signedAt   DateTime       @default(now())
  ipAddress  String?

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([accordId, role])
  @@index([accordId])
}

enum KycStatus {
  NONE
  EMAIL_VERIFIED
  PHONE_VERIFIED
  IDENTITY_VERIFIED
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  currency         String   @default("XOF")
  balanceAvailable Decimal  @default(0) @db.Decimal(18, 2)
  balanceEscrow    Decimal  @default(0) @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String          @id @default(cuid())
  walletId     String
  type         WalletTxType
  amount       Decimal         @db.Decimal(18, 2)
  balanceAfter Decimal         @db.Decimal(18, 2)
  label        String
  accordId     String?
  paymentRef   String?
  rail         PaymentRail?
  status       WalletTxStatus  @default(COMPLETED)
  metadata     Json?
  createdAt    DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model PaymentIntent {
  id          String                @id @default(cuid())
  userId      String
  rail        PaymentRail
  direction   PaymentDirection
  amount      Decimal               @db.Decimal(18, 2)
  phone       String
  externalRef String?               @unique
  status      PaymentIntentStatus   @default(PENDING)
  createdAt   DateTime              @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum WalletTxType {
  CREDIT
  DEBIT
  ESCROW_LOCK
  ESCROW_RELEASE
  TRANSFER_IN
  TRANSFER_OUT
}

enum WalletTxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentRail {
  TMONEY
  FLOOZ
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentDirection {
  DEPOSIT
  WITHDRAW
}

enum NotificationType {
  DUE_DATE_REMINDER
  SIGNATURE_REQUEST
  REPAYMENT_UPDATE
}

model UserNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  href      String?
  accordId  String?
  dedupeKey String           @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accord Accord? @relation(fields: [accordId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}
